    {
      "claim_id": "DK-0d5b2062b148-CL002",
      "statement": "承认圣经有权威却误解或歪曲其信息，会使圣经权威在实际运用中落空，因此正确解经非常重要。",
      "claim_kind": "reasoning_conclusion",
      "attribution": "professor",
      "scripture_refs": [],
      "relations": [],
      "anchors": [
        {
          "transcript_id": "220-426-110-1139",
          "lecture": "220-426-110-1139",
          "paragraph_key": "S0002",
          "media_time": null,
          "evidence_id": "DK-0d5b2062b148-E003",
          "evidence_type": "reasoning",
          "speaker": "professor",
          "stance": "asserted",
          "discourse_role": "由权威推论解经必要性",
          "assertive": true,
          "verbatim_excerpt": "如果我們亂解經，如果我們不把聖經的implication或者聖經的interpretation怎麼能夠把聖經的真的旨意把它瞭解出來的話，我們誤解聖經，把聖經的信息把它歪曲掉，如果是這樣的話，聖經的權威也是不存在的。",
          "highlight_status": "proposed",
          "review_note": null
        }
      ],
      "current_review_status": "candidate",
      "opposes": null
    },
    {
      "claim_id": "DK-0d5b2062b148-CL003",
      "statement": "解经不是把经文解释成自己的意思，而是找出原作者写给原读者时所表达的原来意义。",
      "claim_kind": "interpretive_method",
      "attribution": "professor",
      "scripture_refs": [],
      "relations": [
        {
          "type": "supports",
          "target_claim_id": "DK-0d5b2062b148-CL004",
          "relation_id": "DK-0d5b2062b148-CR002"
