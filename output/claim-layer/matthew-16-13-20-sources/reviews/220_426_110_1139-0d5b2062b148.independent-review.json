      ],
      "anchors": [
        {
          "transcript_id": "220-426-110-1139",
          "lecture": "220-426-110-1139",
          "paragraph_key": "S0002",
          "media_time": null,
          "evidence_id": "DK-0d5b2062b148-E004",
          "evidence_type": "answer",
          "speaker": "professor",
          "stance": "asserted",
          "discourse_role": "术语定义",
          "assertive": true,
          "verbatim_excerpt": "解經就是要我們去找出到底聖經所講的是什麼，叫做 exegesis，就是要把聖經原來所講的，原來的作者……因為聖經其實是原來作者寫給原來的讀者，他所講的意義到底是怎麼一回事。",
          "highlight_status": "proposed",
          "review_note": null
        }
      ],
      "current_review_status": "candidate",
      "opposes": null
    },
    {
      "claim_id": "DK-0d5b2062b148-CL004",
      "statement": "解释一段圣经时，首先必须辨别其文体；若对不同文体使用同一种字面逻辑，就会得出荒谬结论。",
      "claim_kind": "interpretive_method",
