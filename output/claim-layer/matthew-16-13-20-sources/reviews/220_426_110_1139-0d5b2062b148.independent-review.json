          "stance": "asserted",
          "discourse_role": "主题命题",
          "assertive": true,
          "verbatim_excerpt": "聖經的權威的根基，聖經所有的權威，就是因為聖經是神所默示的。",
          "highlight_status": "proposed",
          "review_note": null
