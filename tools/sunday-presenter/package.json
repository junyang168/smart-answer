{
  "name": "sunday-presenter",
  "version": "0.6.3",
  "private": true,
  "description": "Sunday Presenter pilot: local PPT video and paired slide control",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke --focus-smoke",
    "smoke:recording": "electron . --smoke --focus-smoke --recording-smoke",
    "smoke:video": "node build-native.cjs && electron . --smoke --focus-smoke --video-smoke",
    "icons": "node build-icons.cjs",
    "package:mac": "node package-mac.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
